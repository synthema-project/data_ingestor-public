pipeline {
    agent {
        node {
            label 'jenkins-dev'
        }
    }

    parameters {
        string(name: 'K8S_NAMESPACE', defaultValue: 'synthema-dev', description: 'Namespace of the service to remove')
    }
    stages {

        // ****************
        // *** KILL APP ***
        // ****************
        stage("Kill_The_App"){
            steps {
               withKubeConfig([credentialsId: 'k8s-admin']) {
                   sh 'kubectl --namespace "$K8S_NAMESPACE" delete -f k8s/manifest.yml --ignore-not-found'
               }
            }
        }
    }
}
